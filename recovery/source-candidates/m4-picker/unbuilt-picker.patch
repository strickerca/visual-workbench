+/** One queued native chooser; its focus lease also covers the AWT handoff. */
+private class ProjectFilePickerRequest(val owner: java.awt.Frame, private val focusLease: AutoCloseable) : AutoCloseable {
+    private var chooser: FileDialog? = null
+    var retired: Boolean = false
+        private set
+
+    fun create(title: String): FileDialog {
+        check(!retired && chooser == null)
+        return FileDialog(owner, title, FileDialog.LOAD).also { chooser = it }
+    }
+
+    override fun close() {
+        if (retired) return
+        // A failed native disposal keeps the chooser and lease held for retry.
+        chooser?.dispose()
+        chooser = null
+        try { focusLease.close() } finally { retired = true }
+    }
+}
