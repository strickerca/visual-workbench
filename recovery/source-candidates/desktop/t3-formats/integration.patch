+fn export_external(source: &mut dyn RasterSource, state: &ProjectState,
+    document: &Id, options: &FileExportOptions, request: &vw_raster::ExportRequest,
+    cancel: &Cancellation, output: &mut File) -> TransferResult<vw_raster::StreamReport> {
+    let info = source.info();
+    let full = vw_raster::Region { x: 0, y: 0, width: info.width, height: info.height };
+    let (estimate, available, admit) = buffered_admission(source, request)?;
+    let output_region = request.region.unwrap_or(full);
+    // Output and retained source scratch coexist in the same owned workspace.
+    let output_bound = u64::from(output_region.width).checked_mul(u64::from(output_region.height))
+        .and_then(|n| n.checked_mul(8)).and_then(|n| n.checked_add(5 * 1024 * 1024))
+        .ok_or(TransferError::Backpressure)?;
+    if output_bound > options.max_encoded_bytes { return Err(TransferError::EncodedLimit); }
+    let source_scratch = u64::from(info.width).checked_mul(u64::from(info.height))
+        .and_then(|n| n.checked_mul(u64::from(info.bit_depth) / 2)).ok_or(TransferError::Backpressure)?;
+    if source_scratch.checked_add(output_bound).is_none_or(|n| n > options.max_scratch_bytes) {
+        return Err(TransferError::ScratchLimit);
+    }
+    cancel.check()?;
+    let mut image = source.read_region(full, request.memory_budget_bytes, &|| cancel.is_cancelled())
+        .map_err(transfer_raster_error)?;
+    if options.export.marked {
+        let assets = ResultAssets { blobs: &state.blobs, budget: available, cancel };
+        image = vw_raster::render_document(&image, state.project()?, document, &assets,
+            vw_raster::RenderOptions { memory_budget_bytes: available, include_guides: false,
+                assume_untagged_srgb: options.export.assume_untagged_srgb }).map_err(transfer_raster_error)?;
+    }
+    let (length, metadata) = crate::format_images::encode_private(&image, &admit,
+        options.max_encoded_bytes, output, cancel).map_err(transfer_raster_error)?;
+    cancel.check()?;
+    Ok(vw_raster::StreamReport { metadata, plan: vw_raster::StreamPlan {
+        region: output_region, strip_rows: 16.min(output_region.height), estimated_peak_bytes: estimate },
+        encoded_bytes: length, strips: output_region.height.div_ceil(16) })
+}
