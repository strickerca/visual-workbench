+// Seekable codecs may overwrite earlier headers. Hash only finalized bytes.
+fn hash_final_file(file: &mut File, length: u64, hash: &mut blake3::Hasher,
+    cancel: &Cancellation) -> TransferResult<()> {
+    if file.metadata()?.len() != length || length == 0 || length > OUTPUT_LIMIT {
+        return Err(TransferError::Storage);
+    }
+    file.seek(SeekFrom::Start(0))?;
+    let mut remaining = length;
+    let mut buffer = [0u8; 65536];
+    while remaining != 0 {
+        cancel.check()?;
+        let count = remaining.min(buffer.len() as u64) as usize;
+        file.read_exact(&mut buffer[..count])?;
+        hash.update(&buffer[..count]);
+        remaining -= count as u64;
+    }
+    if file.read(&mut [0u8; 1])? != 0 { return Err(TransferError::Storage); }
+    cancel.check()?;
+    Ok(())
+}
